generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Submission {
  id        String           @id @default(cuid())
  type      String
  status    String   @default("NEW")
  name      String
  email     String?
  phone     String?
  payload   String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  @@index([type, status])
  @@index([createdAt])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
